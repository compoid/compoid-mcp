{
 "name": "get_content_raitings",
 "description": "Get the current content acess rating from file.",
 "parameters": {
  "type": "object",
  "properties": {
    "contentCategory": {
     "type": "string",
     "description": "The image content category",
     "enum": ["{{ communityid }}"]
    },
   "contentAccessRatings": {
    "type": "array",
    "description": "List of items within this section",
    "items": {
     "type": "object",
     "properties": {
      "itemName": {
       "type": "string",
       "description": "content acess item name",
       "enum": ["General", "Sensitive", "Proprietary", "Open Access", "Private"]
      },
      "value": {
       "type": "integer",
       "description": "content acess rating value from 0 to 9"
      }
     }
    }
   }
  }
 }
}