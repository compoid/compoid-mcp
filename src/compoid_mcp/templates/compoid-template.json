{
    "access": {
      "embargo": {
        "active": false,
        "reason": null
      },
      "files": "{{ 'restricted' if (community_restricted or not content_public) else 'public' }}",
      "record": "{{ 'restricted' if (community_restricted or not content_public) else 'public' }}",
      "status": "{{ 'restricted' if (community_restricted or not content_public) else 'open' }}"
    },
    "custom_fields": {
      "rdm:classification": {
        "id": "{{ content_class_id }}",
        "title": {
          "en": "{{ content_class_title }}"
        }
      }
    },
    "files": {
        "default_preview": "{{ default_preview }}",
        "enabled": true
    },
    "metadata": {
        "title": "{{ short_caption }}",
        "version": "{{ youtube_video_id }}",
        "contributors": [
          {%- for keyword in keywords %}
          {
            "person_or_org": {
              "name": "{{ keyword }}",
              "type": "organizational"
            },
            "role": {
              "id": "keyword",
              "title": {
                "en": "Keyword"
              }
            }
          },
          {%- endfor %}
          {
            "person_or_org": {
              "name": "{{ community_keywords }}",
              "type": "organizational"
            },
            "role": {
              "id": "keyword",
              "title": {
                "en": "Keyword"
              }
            }
          }
        ],
        "subjects": [
          {%- for subject in subjects %}
          {
            "id": "https://www.compoid.com/subjects#{{ subject_map[subject] }}",
            "scheme": "Subjects",
            "subject": "{{ subject }}"
          },
          {%- endfor %}
          {
            "id": "https://www.compoid.com/subjects#{{ default_subject_map }}",
            "scheme": "Subjects",
            "subject": "{{ default_subject }}"
          }
        ],
        "creators": [
          {%- for creator in creators %}
          {
            "person_or_org": {
              "family_name": "{{ creator }}",
              "name": "{{ creator }}",
              "type": "personal"
            },
            "role": {
              "id": "author",
              "title": {
                "en": "Author"
              }
            }
          },
          {%- endfor %}
          {
            "person_or_org": {
              "family_name": "Qwen",
              "identifiers": [
                {
                  "identifier": "huggingface:Qwen",
                  "scheme": "huggingface"
                }
              ],
              "name": "Qwen",
              "type": "personal"
            },
            "role": {
              "id": "ai-model",
              "title": {
                "en": "AI Model"
              }
            }
          }
        ],
        "publication_date": "{{ publication_date }}",
        "dates": [
            {
                "date": "{{ update_date }}",
                "type": {
                    "id": "updated",
                    "title": {
                        "en": "Updated"
                    }
                }
            }
        ],
        "resource_type": {
            "title": {
                "en": "{{ resourcetype }}"
            },
            "id": "{{ resource_type }}"
        },
        "description": "<p>{{ long_caption }}</p>",
        "related_identifiers": [
          {
            "identifier": "https://huggingface.co/{{ short_alt_caption }}",
            "relation_type": {
              "id": "isdescribedby",
              "title": {
                "en": "Is described by"
              }
            },
            "resource_type": {
              "id": "project",
              "title": {
                "en": "Project"
              }
            },
            "scheme": "url"
          }
        ],
        "rights": [
            {
              "id": "cc-by-sa-4.0"
            }
        ],
        "additional_titles": [
          {
            "title": "0.{{ general_weights }}0",
            "type": {
              "id": "general",
              "title": {
                "en": "General"
              }
            }
          },
          {
            "title": "0.{{ open_access_weights }}0",
            "type": {
              "id": "open",
              "title": {
                "en": "Open Access"
              }
            }
          },
          {
            "title": "0.{{ private_weights }}0",
            "type": {
              "id": "private",
              "title": {
                "en": "Private"
              }
            }
          },
          {
            "title": "0.{{ sensitive_weights }}0",
            "type": {
              "id": "sensitive",
              "title": {
                "en": "Sensitive"
              }
            }
          },
          {
            "title": "0.{{ proprietary_weights }}0",
            "type": {
              "id": "proprietary",
              "title": {
                "en": "Proprietary"
              }
            }
          }
        ],
        "publisher": "Compoid",
        "references": [
          {%- for reference in references %}
          {
            "reference": "{{ reference }}"
          },
          {%- endfor %}
          {
            "reference": "{{ default_reference }}"
          }
        ]
    }
}